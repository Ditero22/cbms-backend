# Copy to .env.production on the production host. Do not commit the populated file.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DATABASE_HOST:5432/cbms
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://cbms.example.com
CORS_ORIGINS=https://cbms.example.com
COOKIE_DOMAIN=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
PG_POOL_MAX=10
TRUST_PROXY=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
