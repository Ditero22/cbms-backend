# Copy to .env.staging on the staging host and populate through its secret manager.
# Never use production database, session, or R2 credentials in this file.
NODE_ENV=production
AUTH_MODE=session
JWT_ACCESS_SECRET=
JWT_ISSUER=cbms-api
JWT_AUDIENCE=cbms-web
JWT_ACCESS_TTL_SECONDS=600
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_STAGING_DATABASE_HOST:5432/cbms_staging?sslmode=require
SESSION_SECRET=GENERATE_A_UNIQUE_STAGING_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://staging.cbms.example.com
CORS_ORIGINS=https://staging.cbms.example.com
COOKIE_DOMAIN=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
PG_POOL_MAX=10
TRUST_PROXY=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
